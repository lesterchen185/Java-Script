        // 1. Ask the user for two numbers
        // Number() converts the typed text into an actual numeric value
        let num1 = Number(prompt("Enter the first number:"));
        let num2 = Number(prompt("Enter the second number:"));

        // 2. Add the numbers together
        let sum = num1 + num2;

        // 3. Output the exact required sentences
        document.write("<pre>");
        document.write("You entered numbers " + num1 + " and " + num2 + "\n");
        document.write("They add up to " + sum);
        document.write("</pre>");
    </script>
  </body>
